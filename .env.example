# Django Secret Key (generate a secure random string for production)
SECRET_KEY=django-insecure-dev-key-change-in-production

# Database Configuration
POSTGRES_DB=ats_db
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_password

# Django Settings
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Ollama Configuration
OLLAMA_HOST=http://host.docker.internal:11434

# Optional: External LLM Configuration
# EXTERNAL_LLM_API_KEY=your-api-key-here
# EXTERNAL_LLM_ENDPOINT=https://api.example.com/v1